{
  "provider": {
    "name": "openai_compatible",
    "base_url": "https://ravavct.abc-tunnel.us/v1",
    "model": "gh/gpt-5-mini",
    "api_key_env": "AI_API_KEY",
    "env_file": ".env",
    "timeout_seconds": 60,
    "temperature": 0.1,
    "stream": false
  },
  "analysis": {
    "language": "vi",
    "max_findings": 50,
    "max_payload_chars": 500,
    "max_detail_chars": 1200
  },
  "redaction": {
    "enabled": true,
    "sensitive_keys": [
      "authorization",
      "cookie",
      "set-cookie",
      "password",
      "token",
      "secret",
      "api_key",
      "apikey"
    ]
  },
  "output_dir": "ai-output"
}
