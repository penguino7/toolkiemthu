{
  "base_url": "http://127.0.0.1:12001",
  "headers": {
    "User-Agent": "ReconTool/0.2"
  },
  "scope": {
    "include_hosts": ["127.0.0.1", "localhost"],
    "exclude_paths": ["/user/logout.php"]
  },
  "seeds": [
    "/",
    "/search.php?q=test",
    "/news.php?id=1",
    "/category.php?id=1",
    "/spa/search",
    "/spa/article/1",
    "/spa/comments/1",
    "/spa/logs"
  ],
  "static": {
    "max_pages": 80,
    "max_depth": 3,
    "timeout_seconds": 10
  },
  "dynamic": {
    "max_pages": 30,
    "timeout_ms": 15000,
    "headless": true,
    "click_selectors": [],
    "max_clicks_per_page": 0,
    "deny_click_texts": ["logout", "delete", "remove", "submit", "sign out"],
    "resource_types": ["document", "xhr", "fetch"],
    "auto_scroll": false,
    "scroll_steps": 0,
    "scroll_delay_ms": 300,
    "debug": false
  },
  "dedupe": {
    "mode": "smart"
  }
}
