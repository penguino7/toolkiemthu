{
  "base_url": "http://127.0.0.1:12001",
  "headers": {
    "User-Agent": "FuzzTool/0.1"
  },
  "scope": {
    "include_hosts": ["127.0.0.1", "localhost"],
    "exclude_paths": ["/user/logout.php"]
  },
  "safety": {
    "max_requests": 800,
    "delay_seconds": 0.05,
    "request_timeout_seconds": 15,
    "use_environment_proxy": false,
    "skip_param_names": [
      "csrf",
      "csrf_token",
      "_csrf",
      "token",
      "auth",
      "authorization",
      "password",
      "pass",
      "pwd",
      "session",
      "sid",
      "phpsessid"
    ]
  },
  "xss": {
    "enabled": false,
    "payload_mode": "proof",
    "reflected": true,
    "stored": true,
    "dom": true,
    "stored_check_paths": [
      "/news.php?id=1",
      "/spa/comments/1",
      "/spa/logs"
    ],
    "dom_headless": true,
    "dom_timeout_ms": 8000,
    "post_load_wait_ms": 500
  },
  "sqli": {
    "enabled": false,
    "error_based": true,
    "boolean_based": true,
    "union_based": true,
    "union_max_columns": 20,
    "union_marker_prefix": "FUZZUNION"
  },
  "output_dir": "fuzz-output"
}
